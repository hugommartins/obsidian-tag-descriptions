{
  "name": "obsidian-tag-descriptions",
  "version": "1.1.0",
  "description": "A knowledge management utility that allows the assignment of custom definitions to tags.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --minify",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^25.0.9",
