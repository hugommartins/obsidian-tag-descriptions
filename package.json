    "esbuild": "^0.28.2",
    "eslint-plugin-obsidianmd": "^0.1.8",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.53.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugommartins/obsidian-tag-descriptions.git"
